FoamFile
{
    version   2.0;
    format    ascii;
    class     dictionary;
    location  "system";
    object    meshDict;
}

writeLineageDiagnostics false;
writeLineageStages (postBLCreate postOptimize postRefBL final);


surfaceFile "constant/triSurface/Rotor37_cfmesh.stl";

dirtyRecoverableMaxNegVol 10;
enableRung2TJSmoother true; // EXPERIMENT
enablePostBLRescue true;
rung2MaxRings 4; // need more rings for interior movable points // EXPERIMENT -- default 5, testing recovery of 6-10 cell cases

geometryPreprocessing
{
    active                true;
    reportOnly            false;
    weldNearPoints        false;
    selectiveWeld         false;
    weldTolerance         1e-4;
    autoScaleWithCellSize false;
    minFeatureToCellRatio 0.20;
    writeDiagnostics      false;
}

maxCellSize 0.003;
boundaryCellSize 0.001;
minCellSize 0.0005;
insideMesh (0.214 0.000 0.025);

localRefinement
{
    blade_1    { cellSize 0.0005; }
    blade_2    { cellSize 0.0005; }
    blade_3    { cellSize 0.0005; }
    blade_4    { cellSize 0.0005; }
    hub        { cellSize 0.001; }
    shroud     { cellSize 0.001; }
    periodic_1 { cellSize 0.0005; }
    periodic_2 { cellSize 0.0005; }
}

boundaryLayers
{
    blSharpEdgeAngleDeg 85;
    useContactLinePolicy true;
    useContactLineHeightSmoother true;
    writeContactLineHeightSmootherAtlas true;
    contactLineSmootherMaxGrowth 1.5;
    contactLineSmootherMinCollapse 0.05;
    contactLineSmootherMaxMoveFraction 0.25;
    contactLineSmootherIterations 1;
    contactLineSmootherMinHeight 1e-8;
    useHardBLBLCapCells true;
    useHardBLBLCapVertexInsertion true;
    useHardBLBLReducedCells true;
    useHardBLBLAsymmetricCapFaces false;
    hardBLBLCapScale 0.10;
    nLayers 0;
    patchRoles
    {
        wall        (blade_1 blade_2 blade_3 blade_4 hub shroud);
        blade       (blade_1 blade_2 blade_3 blade_4);
        hub         (hub);
        shroud      (shroud);
        periodic    (periodic_1 periodic_2);
        inletOutlet (inlet outlet);
    }

    terminationPatches (inlet outlet);

    // BL/BL junction detection
    blblFeatureAngleDeg     35.0;
    blblCornerAcuteThreshold 0.5;
    lockAcuteCornerPoints   true;

    // Acute corner local taper (seeded from blblAcuteCornerPoints_)
    acuteCornerRing0        0.0;
    acuteCornerRing1        0.02;
    acuteCornerRing2        0.05;
    acuteCornerRing3        0.15;
    acuteCornerRing4        0.35;
    acuteCornerRing5        0.60;
    acuteCornerRing6        1.00;

    acuteCornerCapLayers    false;

    // Enable boundary layer optimisation pass
    optimiseLayer           false;
    optimiseLayerBuffer     false;

    // Virtual topology: suppress BL at acute triple-junctions
    virtualTopologyExclusion  true;
    virtualTopoRing0          0.05;
    virtualTopoRing1          0.15;
    virtualTopoRing2          0.40;

    // Post-BL repair: classify periodic transition faces and avoid unsafe flips
    periodicTransitionProtection true;
    periodicTransitionSkipFlip   true;
    periodicTransitionPatches    (periodic_1 periodic_2);

    // Gap/proximity detection: suppress BL where BL patches are too close
    detectGaps            true;
    gapThreshold          1e-5;
    gapPatchPairs
    (
        (blade_1 shroud)
        (blade_2 shroud)
        (blade_3 shroud)
        (blade_4 shroud)
    );
    gapSuppressPatches (shroud hub);
    tripleJunctionSuppressPatches (hub shroud);
    tripleJunctionFaceRingExclusion true;
    tripleJunctionProtectedRing0Scale 0.5;
    tripleJunctionWallPatches     (blade_1 blade_2 blade_3 blade_4);
    tripleJunctionNeutralPatches  (periodic_1 periodic_2);  // suppress shroud+hub BL, protect blade

    // Post-optimizer surface re-projection (Layer 3 constraint recovery)
    postBLSnap                          true;
    postBLSnapTolerance                 1e-4;
    postBLSnapAllowedPyramidIncrease    25;
    postBLSnapAllowedPyramidIncreaseFraction 0.001;

    // Surface-constrained optimizer: re-project boundary pts during optimization
    constrainOptimizerBoundaryMotion true;

    // Limited-displacement incremental re-projection after optimizeMeshFV
    postOptimizerReprojStepFraction     0.005;
    postOptimizerReprojPasses           10;

    gapConflictMode       autoThickness;
    gapLoserRing1Suppress false;
    gapLoserRing1MaxLayers 3;
    gapLoserRing2MaxLayers 3;
    blTerminationRing1MaxLayers 3;
    blTerminationRing2MaxLayers 3;
    gapFaceRingExclusion  true;
    postOptBLRetraction     false;
    postOptBLRetractionRings 1;

    // ---------------------------------------------------------------
    // PRE-refBL SNAPSHOT
    // Takes a copy of the mesh state before refineLayers() runs.
    // Required by the two-pass repair loop below.
    // Safe to leave true -- no cost unless preRefBLAutoRepair fires.
    // ---------------------------------------------------------------
    preRefBLSnapshot        true;

    // ---------------------------------------------------------------
    // POST-refBL REPAIR -- TWO MECHANISMS, USE ONE OR THE OTHER.
    //
    // MECHANISM 1 (NEW -- preferred): Two-pass in-scope repair loop.
    //   Pass 1: run refineLayers(), detect bad pyramid faces, trace
    //           them to provenance bfI seeds (computed fresh, in-scope).
    //   Pass 2: restore pre-refBL snapshot, apply BLRepairPlan
    //           (tapered caps + thickness scales per junction type),
    //           re-run refineLayers(), accept only if negVol no worse
    //           AND badPyramids lower. Restore pass-1 if rejected.
    //   Enable:  preRefBLAutoRepair true
    //   Requires: preRefBLSnapshot true
    //
    // MECHANISM 2 (OLD -- manual debug/replay only): File-based
    //   provenance retraction. Reads bfI seeds written by a previous
    //   run and retracts those faces before refineLayers(). Seeds are
    //   stale the moment any code, refinement, or optimizer change
    //   occurs. Never combine with preRefBLAutoRepair true.
    //   To use: set postRefBLProvenanceRetraction true AND ensure
    //   postRefBLProvenanceSeedFile is current for this mesh state.
    //
    // CURRENT STATE: Mechanism 1 active, Mechanism 2 disabled.
    // ---------------------------------------------------------------

    // Mechanism 1 -- two-pass in-scope repair (NEW)
    preRefBLAutoRepair      true;

    // Mechanism 2 -- file-based replay (OLD, manual debug only)
    postRefBLProvenanceRetraction false;
    postRefBLProvenanceSeedFile postRefBL_provenanceSeedBfI.labels;

    // Ring caps and thickness scales used by Mechanism 1 repair plans.
    // wall-wall junctions (blade/hub, blade/shroud): conservative.
    // wall-periodic junctions: moderate.
    postRefBLRing0MaxLayers 3;
    postRefBLRing1MaxLayers 4;
    postRefBLRing2MaxLayers 0;
    postRefBLRing0ThicknessScale 0.60;
    postRefBLRing1ThicknessScale 0.80;
    postRefBLRing2ThicknessScale 1.00;
    gapFaceRing0Scale     0.02;
    gapFaceRing1Scale     0.05;
    gapFaceRing2Scale     0.20;
    gapFaceRing3Scale     0.50;

    // Snap settings
    cornerSnapRelaxation 0.25;
    cornerSnapIterations 1;
    edgeSnapRelaxation   1.0;
    edgeSnapIterations   1;
    snapMinPyramidHeight 1e-10;
    postBLSnap           true;
    postRefineBLOptimisation true;

    // BL transition ramp — smooth 6-ring taper
    layerScaleRing1 0.25;
    flowTerminationTaperFloor 0.25;
    periodicNeutralTaperFloor 0.20;
    layerScaleRing2 0.50;
    layerScaleRing3 0.45;
    layerScaleRing4 0.65;
    layerScaleRing5 0.80;
    layerScaleRing6 1.00;

    thicknessRatio          1.3;
    maxFirstLayerThickness  1e-4;

    patchBoundaryLayers
    {
        blade_1 { nLayers 3; thicknessRatio 1.2; maxFirstLayerThickness 5e-5; }
        blade_2 { nLayers 3; thicknessRatio 1.2; maxFirstLayerThickness 5e-5; }
        blade_3 { nLayers 3; thicknessRatio 1.2; maxFirstLayerThickness 5e-5; }
        blade_4 { nLayers 3; thicknessRatio 1.2; maxFirstLayerThickness 5e-5; }
        hub     { nLayers 3; thicknessRatio 1.3; maxFirstLayerThickness 1e-4; }
        shroud  { nLayers 3; thicknessRatio 1.3; maxFirstLayerThickness 1e-4; }
        inlet   { nLayers 0; }
        outlet  { nLayers 0; }
        periodic_1 { nLayers 0; }
        periodic_2 { nLayers 0; }
    }
}

renameBoundary
{
    defaultName     walls;
    defaultType     wall;
    newPatchNames
    {
        inlet      { newName inlet;      type patch; }
        outlet     { newName outlet;     type patch; }
        hub        { newName hub;        type wall;  }
        shroud     { newName shroud;     type wall;  }
        periodic_1 { newName periodic_1; type patch; }
        periodic_2 { newName periodic_2; type patch; }
        blade_1    { newName blade_1;    type wall;  }
        blade_2    { newName blade_2;    type wall;  }
        blade_3    { newName blade_3;    type wall;  }
        blade_4    { newName blade_4;    type wall;  }
    }
}

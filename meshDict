FoamFile
{
    version   2.0;
    format    ascii;
    class     dictionary;
    location  "system";
    object    meshDict;
}

// ============================================================
// NASA Rotor 37 -- cfMesh-OpenFOAM13 tutorial mesh
// Repo: https://github.com/Ultravis66/cfMesh-OpenFOAM13
// ============================================================

surfaceFile "constant/triSurface/Rotor37_cfmesh.stl";

// ------------------------------------------------------------
// Geometry preprocessing
// ------------------------------------------------------------
geometryPreprocessing
{
    active                true;
    reportOnly            false;
    weldNearPoints        false;
    selectiveWeld         false;
    weldTolerance         1e-4;
    autoScaleWithCellSize false;
    minFeatureToCellRatio 0.20;
    writeDiagnostics      false;
}

// ------------------------------------------------------------
// Base mesh sizing
// ------------------------------------------------------------
maxCellSize      0.003;
boundaryCellSize 0.001;
minCellSize      0.0005;
insideMesh       (0.214 0.000 0.025);

// ------------------------------------------------------------
// Local surface refinement
// ------------------------------------------------------------
localRefinement
{
    blade_1    { cellSize 0.0005; }
    blade_2    { cellSize 0.0005; }
    blade_3    { cellSize 0.0005; }
    blade_4    { cellSize 0.0005; }
    hub        { cellSize 0.001;  }
    shroud     { cellSize 0.001;  }
    periodic_1 { cellSize 0.0005; }
    periodic_2 { cellSize 0.0005; }
}

// ------------------------------------------------------------
// Boundary layer controls
// ------------------------------------------------------------
boundaryLayers
{
    nLayers 0;
    terminationPatches (inlet outlet);

    // -- BL/BL junction detection --------------------------------
    blblFeatureAngleDeg      35.0;
    blblCornerAcuteThreshold 0.5;
    lockAcuteCornerPoints    true;

    // Acute corner layerScale taper
    acuteCornerRing0  0.00;
    acuteCornerRing1  0.02;
    acuteCornerRing2  0.05;
    acuteCornerRing3  0.15;
    acuteCornerRing4  0.35;
    acuteCornerRing5  0.60;
    acuteCornerRing6  1.00;
    acuteCornerCapLayers false;

    // -- BL optimisation -----------------------------------------
    optimiseLayer        false;
    optimiseLayerBuffer  false;
    postRefineBLOptimisation true;

    // -- Virtual topology ----------------------------------------
    virtualTopologyExclusion true;
    virtualTopoRing0          0.05;
    virtualTopoRing1          0.15;
    virtualTopoRing2          0.40;

    tripleJunctionSuppressPatches  (hub shroud);
    tripleJunctionFaceRingExclusion true;
    tripleJunctionWallPatches      (blade_1 blade_2 blade_3 blade_4);
    tripleJunctionNeutralPatches   (periodic_1 periodic_2);

    // -- Gap/proximity detection ---------------------------------
    detectGaps       true;
    gapThreshold     1e-5;
    gapPatchPairs
    (
        (blade_1 shroud)
        (blade_2 shroud)
        (blade_3 shroud)
        (blade_4 shroud)
    );
    gapSuppressPatches  (shroud hub);
    gapFaceRingExclusion true;
    gapFaceRing0Scale    0.02;
    gapFaceRing1Scale    0.05;
    gapFaceRing2Scale    0.20;

    // -- Periodic transition protection --------------------------
    periodicTransitionProtection true;
    periodicTransitionSkipFlip   true;
    periodicTransitionPatches    (periodic_1 periodic_2);

    // -- Surface-constrained optimizer ---------------------------
    constrainOptimizerBoundaryMotion true;

    // -- Post-optimizer re-projection ----------------------------
    postOptimizerReprojStepFraction  0.005;
    postOptimizerReprojPasses        10;

    // -- Pre-BL snap ---------------------------------------------
    postBLSnap                           true;
    postBLSnapTolerance                  1e-4;
    postBLSnapAllowedPyramidIncrease     25;
    postBLSnapAllowedPyramidIncreaseFraction 0.001;

    // -- Snapping controls ---------------------------------------
    cornerSnapRelaxation  0.25;
    cornerSnapIterations  1;
    edgeSnapRelaxation    1.0;
    edgeSnapIterations    1;
    snapMinPyramidHeight  1e-10;

    // -- BL thickness ramp ---------------------------------------
    layerScaleRing1  0.25;
    layerScaleRing2  0.50;
    layerScaleRing3  0.45;
    layerScaleRing4  0.65;
    layerScaleRing5  0.80;
    layerScaleRing6  1.00;

    // -- Contact-line policies (Jun 28 2026) ---------------------
    // FlowBoundaryTermination: separate taper from layerScaleRing1
    flowTerminationTaperFloor 0.25;

    // PeriodicSeam: gentle taper at blade/periodic junctions
    periodicNeutralTaperFloor 0.20;

    // -- Contact-line height smoother ----------------------------
    useContactLinePolicy             true;
    useContactLineHeightSmoother     true;
    writeContactLineHeightSmootherAtlas false;
    contactLineSmootherMaxGrowth     1.5;
    contactLineSmootherMinCollapse   0.05;
    contactLineSmootherMaxMoveFraction 0.25;
    contactLineSmootherIterations    1;
    contactLineSmootherMinHeight     1e-8;

    // -- Hard BL/BL cap cells ------------------------------------
    useHardBLBLCapCells          true;
    useHardBLBLCapVertexInsertion true;
    useHardBLBLReducedCells      true;
    useHardBLBLAsymmetricCapFaces false;
    hardBLBLCapScale             0.10;

    // -- Pre-refBL snapshot (two-pass repair) --------------------
    preRefBLSnapshot true;

    thicknessRatio          1.3;
    maxFirstLayerThickness  1e-4;

    // -- Per-patch BL settings -----------------------------------
    patchBoundaryLayers
    {
        blade_1    { nLayers 3; thicknessRatio 1.2; maxFirstLayerThickness 5e-5; }
        blade_2    { nLayers 3; thicknessRatio 1.2; maxFirstLayerThickness 5e-5; }
        blade_3    { nLayers 3; thicknessRatio 1.2; maxFirstLayerThickness 5e-5; }
        blade_4    { nLayers 3; thicknessRatio 1.2; maxFirstLayerThickness 5e-5; }
        hub        { nLayers 3; thicknessRatio 1.3; maxFirstLayerThickness 1e-4; }
        shroud     { nLayers 3; thicknessRatio 1.3; maxFirstLayerThickness 1e-4; }
        inlet      { nLayers 0; }
        outlet     { nLayers 0; }
        periodic_1 { nLayers 0; }
        periodic_2 { nLayers 0; }
    }
}

// ------------------------------------------------------------
// Boundary patch renaming and types
// ------------------------------------------------------------
renameBoundary
{
    defaultName  walls;
    defaultType  wall;
    newPatchNames
    {
        inlet      { newName inlet;      type patch; }
        outlet     { newName outlet;     type patch; }
        hub        { newName hub;        type wall;  }
        shroud     { newName shroud;     type wall;  }
        periodic_1 { newName periodic_1; type patch; }
        periodic_2 { newName periodic_2; type patch; }
        blade_1    { newName blade_1;    type wall;  }
        blade_2    { newName blade_2;    type wall;  }
        blade_3    { newName blade_3;    type wall;  }
        blade_4    { newName blade_4;    type wall;  }
    }
}
